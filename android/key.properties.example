# Copy this file to android/key.properties and fill in your real values.
# android/key.properties is git-ignored — NEVER commit it or the .jks file.
#
# storeFile is resolved relative to the android/ folder (absolute paths also work).
# Example: storeFile=bunnoku-upload.jks  -> android/bunnoku-upload.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=upload
storeFile=bunnoku-upload.jks
